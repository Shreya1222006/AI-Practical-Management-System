# Common environment variables (fill per-environment)

# General
NODE_ENV=development

# Default ports for services
PORT_API_GATEWAY=4000
PORT_AUTH_SERVICE=4010
PORT_SUBMISSION_SERVICE=4020
PORT_EXECUTION_RUNNER=4030
PORT_FILE_SERVICE=4040
PORT_ASSESSMENTS_SERVICE=4050
PORT_USER_SERVICE=4060
PORT_PRACTICALS_SERVICE=4070

# Service URLs (for Gateway and inter-service communication)
API_GATEWAY_URL=http://localhost:4000
AUTH_SERVICE_URL=http://localhost:4010
SUBMISSION_SERVICE_URL=http://localhost:4020
EXECUTION_RUNNER_URL=http://localhost:4030
FILE_SERVICE_URL=http://localhost:4040
ASSESSMENTS_SERVICE_URL=http://localhost:4050
USER_SERVICE_URL=http://localhost:4060
PRACTICALS_SERVICE_URL=http://localhost:4070


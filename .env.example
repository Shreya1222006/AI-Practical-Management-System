#KAFKA_BROKERS=localhost:9092

# Execution runner & Docker sandboxing settings
DEFAULT_ENVIRONMENT=cpp-gcc
IMAGE_CPP=vpl-cpp-runner:1.0
IMAGE_PYTHON_DL=vpl-python-dl:1.0
IMAGE_POSTGRES=vpl-postgres-runner:1.0
DOCKER_SOCKET_PATH=\\.\pipe\docker_engine
EXECUTION_DEFAULT_TIME_LIMIT_SEC=30
EXECUTION_DEFAULT_MEMORY_MB=512
EXECUTION_MAX_CONCURRENT_RUNS=4

# Monitoring & logging
SENTRY_DSN=
LOG_LEVEL=info

# NOTE: Do not commit real secrets to public repositories. Use a secrets manager for production values.
